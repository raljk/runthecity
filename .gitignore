# Publish the game, landing-page artwork, sound packs and sound scripts. Everything else stays local (notes, raw art, the API key file).
/*
!/index.html
!/sound-fx.bin
!/sound-table.bin
# the scripts that make the sound, but not the audio they make or the audition pages
!/sound/
/sound/*
!/sound/*.py
!/sound/README.md
!/.gitignore
!/art/
/art/*
!/art/landing/
/art/landing/*
!/art/landing/city-poster.jpg
!/art/landing/crews-poster.png
!/art/landing/PROMPTS.md
!/art/landing/city-street.jpg
!/art/landing/run-the-city.svg
# the Director's story panels (release 4): loaded by the table screen when a move needs one
!/art/panels/

# Compressed landing media and cacheable game artwork
!/art/landing/*.webp
!/art/game/

!/art/landing/social-preview.jpg
!/art/landing/SOCIAL.md

# Transparent three-frame stickers and splats
!/art/talk/
# the game loads the WebP copies; the PNG masters stay on the machine that made them (dev/webp/convert.py)
/art/talk/*.png
# the winner's poster painting (release 6): loaded by their phone when it makes the poster
!/art/show/
# the coach's lines (onboarding): fetched only by a phone being coached
!/sound-coach.bin
